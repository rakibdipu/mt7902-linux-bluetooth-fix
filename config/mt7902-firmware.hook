#!/bin/sh
set -e
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
copy_file firmware /lib/firmware/mediatek/BT_RAM_CODE_MT7902_1_1_hdr.bin 2>/dev/null || true
copy_file firmware /lib/firmware/mediatek/BT_RAM_CODE_MT7902_1_1_hdr.bin.zst 2>/dev/null || true
copy_file firmware /lib/firmware/mediatek/WIFI_MT7902_patch_mcu_1_1_hdr.bin.zst 2>/dev/null || true
copy_file firmware /lib/firmware/mediatek/WIFI_RAM_CODE_MT7902_1.bin.zst 2>/dev/null || true
